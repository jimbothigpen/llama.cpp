#version 450

#include "dequant_head.glsl"

// 128 elements per block (QUANT_K_TURBOQ8_0 = 128).
// Each workgroup processes one block. 128 threads, 1 element per thread.
// 8-bit uniform 256-level grid: centroid = (qs - 127.5)/127.5; recon = norm * centroid.
// Stays in the WHT-rotated domain (no inverse rotation), matching the FA dequant
// path and the CUDA/CPU turboq8 vec reference reconstruction.
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {block_turboq8_0 data_a[];};
layout (binding = 1) writeonly buffer D {D_TYPE data_b[];};

void main() {
    const uint ib  = gl_WorkGroupID.x;
    const uint j   = gl_LocalInvocationID.x;

    if (ib >= p.nel / 128) return;

    const float norm = float(data_a[ib].norm) * (1.0 / 127.5);
    const float c    = float(uint(data_a[ib].qs[j])) - 127.5;

    data_b[ib * 128 + j] = D_TYPE(c * norm);
}
