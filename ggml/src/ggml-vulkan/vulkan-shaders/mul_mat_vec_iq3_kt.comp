#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage  : require

#include "mul_mat_vec_base.glsl"

// IQ3_KT — see dequant_iq3_kt.comp for layout.  Bound as uint32_t[].
// Block size = 24 u32 (96 B); row stride = 1 + nb * 24 u32 (1 u32 = float row_scale).
// IS_ABS=true: all codebook outputs are abs(val), range [0,126].
//
// Threading:
//   - 64 threads/WG, 8 threads per super-block (1 thread per sub-block)
//   - 8 super-blocks of A loaded into shmem cooperatively per outer iter
//     (192 u32 = 768 B shmem)
//   - Each thread loops over 4 groups in its sub-block (GROUP_SIZE=8), running
//     the trellis decode per group and accumulating.

#define BLOCKS_PER_WG  8
#define U32_PER_BLOCK 24

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

const uint IQ3KT_KA      = 0xCBAC1FEDu;
const uint IQ3KT_OffsetA  = 4096u;            // codebook A (selector bit == 0)
const uint IQ3KT_OffsetB  = 4096u + 32768u;   // codebook B (selector bit == 1) = 36864u
// Dual-codebook: shb[ib] bit 24 selects the implicit codebook per sub-block.
// Old files have bit 24 == 0, mapping to OffsetA = 4096 (backward-compatible).

void iq3kt_gen_group(uint idx, uint koff, out float result[8]) {
    uint x = idx + koff;
    [[unroll]] for (int k = 0; k < 8; k++) {
        x = IQ3KT_KA * x;
        const uint s = x & 0x3f3f3f3fu;
        const int sum =  int(s         & 0xffu)
                       + int((s >>  8) & 0xffu)
                       + int((s >> 16) & 0xffu)
                       + int((s >> 24) & 0xffu);
        const int sv = sum - 126;
        result[k] = float(sv);
    }
}

shared uint shmem_a[BLOCKS_PER_WG * U32_PER_BLOCK];

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    uint a_offset, b_offset, d_offset;
    get_offsets(a_offset, b_offset, d_offset);

    const uint num_blocks_per_row = p.ncols / QUANT_K;     // QUANT_K = 256
    const uint row_size_u32       = 1u + num_blocks_per_row * U32_PER_BLOCK;

    const uint tid = gl_LocalInvocationID.x;
    const uint ib  = tid & 7u;     // sub-block 0..7
    const uint ix  = tid >> 3;     // block-in-WG 0..7

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint k = 0; k < NUM_ROWS; ++k) {
            temp[j][k] = FLOAT_TYPE(0);
        }
    }

    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        const uint row     = first_row + n;
        // MUL_MAT_ID: a_offset (QUANT_K-block units) selects the expert; convert to per-row u32
        // stride (incl. +1 row-meta word). Dense / non-id path has a_offset == 0 (no-op).
        const uint row_u32 = (a_offset / num_blocks_per_row + row) * row_size_u32;
        const float d_row  = uintBitsToFloat(data_a[row_u32]);

        for (uint i_base = 0; i_base < num_blocks_per_row; i_base += BLOCKS_PER_WG) {
            const uint blocks_this_iter = min(uint(BLOCKS_PER_WG),
                                              num_blocks_per_row - i_base);
            const uint u32_to_load = blocks_this_iter * U32_PER_BLOCK;

            barrier();
            [[unroll]] for (uint pi = 0; pi < 3; ++pi) {
                const uint shmem_idx = tid + pi * 64u;
                if (shmem_idx < u32_to_load) {
                    const uint local_block  = shmem_idx / U32_PER_BLOCK;
                    const uint u32_in_block = shmem_idx - local_block * U32_PER_BLOCK;
                    const uint global_block = i_base + local_block;
                    const uint global_u32   = row_u32 + 1u + global_block * U32_PER_BLOCK + u32_in_block;
                    shmem_a[shmem_idx] = data_a[global_u32];
                }
            }
            barrier();

            const uint local_block_idx = ix;
            const uint global_block    = i_base + local_block_idx;
            if (global_block < num_blocks_per_row) {
                const uint shmem_base = local_block_idx * U32_PER_BLOCK;

                const uint shb  = shmem_a[shmem_base + ib];
                const int  ls   = int((shb & 0xffu)) - 128;
                const float dl  = d_row * float(ls);

                // Per-sub-block codebook selector (bit 24 of shb).
                const uint koff = ((shb >> 24u) & 1u) != 0u ? IQ3KT_OffsetB : IQ3KT_OffsetA;

                const uint y_base = global_block * 256u + ib * 32u;

                [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                    FLOAT_TYPE sum = FLOAT_TYPE(0.0);
                    [[unroll]] for (uint g = 0u; g < 4u; g++) {
                        const uint jj = ib * 4u + g;

                        // ql: shmem_base+8 .. shmem_base+15 (4 groups per u32)
                        const uint ql_word = shmem_a[shmem_base + 8u + (jj >> 2)];
                        const uint ql_byte = (ql_word >> ((jj & 3u) * 8u)) & 0xffu;

                        // qh: shmem_base+16 .. shmem_base+19 (2 groups per nibble per byte)
                        const uint qh_byte_idx  = jj >> 1;
                        const uint qh_nib_shift = (jj & 1u) * 4u;
                        const uint qh_word      = shmem_a[shmem_base + 16u + (qh_byte_idx >> 2)];
                        const uint qh_byte_val  = (qh_word >> ((qh_byte_idx & 3u) * 8u)) & 0xffu;
                        const uint qh_nibble    = (qh_byte_val >> qh_nib_shift) & 0xfu;

                        const uint sh_4bits = (shb >> (8u + 4u * g)) & 0xfu;
                        const uint idx      = ql_byte | (qh_nibble << 8u) | (sh_4bits << 12u);

                        float gv[8];
                        iq3kt_gen_group(idx, koff, gv);

                        const uint b_idx = j * p.batch_stride_b + b_offset + y_base + g * 8u;
                        [[unroll]] for (uint i = 0u; i < 8u; i++) {
                            sum = fma(FLOAT_TYPE(gv[i]),
                                      FLOAT_TYPE(data_b[b_idx + i]),
                                      sum);
                        }
                    }
                    temp[j][n] = fma(FLOAT_TYPE(dl), sum, temp[j][n]);
                }
            }
        }
    }

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
