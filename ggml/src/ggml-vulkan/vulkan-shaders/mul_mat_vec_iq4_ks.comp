#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage  : require

#include "mul_mat_vec_base.glsl"

// IQ4_KS — see dequant_iq4_ks.comp for layout.  data_a[] is bound as
// uint32_t[] (A_TYPE in types.glsl); 136B/block = 34 u32, row stride
// 4 + nb*136 is always 4-aligned.
//
// Threading mirrors the IQ3_KS shmem-cached design:
//   - 64 threads/WG, 8 threads per super-block (1 thread per sub-block)
//   - 8 blocks of A loaded into shared memory cooperatively per outer iter
//     (eliminates the 8× redundant per-thread global reads of qs/scales)
//   - NUM_ROWS rows per WG; shmem reloaded per row (rows have different addrs)

#define BLOCKS_PER_WG 8
#define U32_PER_BLOCK 34

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

const int iq4k_values_const[32] = int[32](
    -127, -104, -83, -65, -49, -35, -22, -10,    1,  13,  25,  38,  53,  69,  89, 113,
    -123, -100, -79, -61, -45, -31, -18,  -6,    5,  17,  29,  42,  57,  73,  93, 117
);

// 8 blocks × 34 u32 = 272 uints = 1088 bytes shared memory.
shared uint shmem_a[BLOCKS_PER_WG * U32_PER_BLOCK];

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    uint a_offset, b_offset, d_offset;
    get_offsets(a_offset, b_offset, d_offset);
    // a_offset is in QUANT_K-block units; for MUL_MAT_ID it selects the expert (see row_u32 below).

    const uint num_blocks_per_row = p.ncols / QUANT_K;
    const uint row_size_u32       = 1 + num_blocks_per_row * U32_PER_BLOCK;

    const uint tid = gl_LocalInvocationID.x;
    const uint ib  = tid & 7;     // 0..7 — sub-block index this thread handles
    const uint ix  = tid >> 3;    // 0..7 — block-in-WG index (assumes WG=64)

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint k = 0; k < NUM_ROWS; ++k) {
            temp[j][k] = FLOAT_TYPE(0);
        }
    }

    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        const uint row     = first_row + n;
        // MUL_MAT_ID: a_offset (QUANT_K-block units) selects the expert. rows-before-expert =
        // a_offset / num_blocks_per_row, scaled by the per-row u32 stride (incl. the +1 row-meta
        // word). Dense / non-id path has a_offset == 0, so this is a no-op there.
        const uint row_u32 = (a_offset / num_blocks_per_row + row) * row_size_u32;
        const float d_row  = uintBitsToFloat(data_a[row_u32]);

        for (uint i_base = 0; i_base < num_blocks_per_row; i_base += BLOCKS_PER_WG) {
            const uint blocks_this_iter = min(uint(BLOCKS_PER_WG),
                                              num_blocks_per_row - i_base);
            const uint u32_to_load = blocks_this_iter * U32_PER_BLOCK;  // ≤ 272

            barrier();
            // Each thread loads up to 5 u32s (272 / 64 = 4.25, round up to 5 with bounds).
            [[unroll]] for (uint pi = 0; pi < 5; ++pi) {
                const uint shmem_idx = tid + pi * 64;
                if (shmem_idx < u32_to_load) {
                    const uint local_block = shmem_idx / U32_PER_BLOCK;
                    const uint u32_in_block = shmem_idx - local_block * U32_PER_BLOCK;
                    const uint global_block = i_base + local_block;
                    const uint global_u32   = row_u32 + 1 + global_block * U32_PER_BLOCK + u32_in_block;
                    shmem_a[shmem_idx] = data_a[global_u32];
                }
            }
            barrier();

            // Each 8-thread group handles its block from shmem.
            const uint local_block_idx = ix;
            const uint global_block = i_base + local_block_idx;
            if (global_block < num_blocks_per_row) {
                const uint shmem_base = local_block_idx * U32_PER_BLOCK;

                // Read scale byte for this thread's sub-block.
                const uint sc_word_idx = shmem_base + (ib >> 2);  // 0 or 1
                const uint sc_byte = (shmem_a[sc_word_idx] >> ((ib & 3) * 8)) & 0xff;
                const int  ls = int(sc_byte & 254) - 127;
                const float dl = d_row * float(ls);
                const uint codebook_off = (sc_byte & 1) << 4;

                // qs base for this sub-block: 4 u32 starting at shmem_base + 2 + ib*4
                // (16 qs bytes per sub-block).
                const uint qs_u32_base = shmem_base + 2 + ib * 4;

                // y_base: which 32-element slice of B this sub-block dots with.
                const uint y_base = global_block * 256 + ib * 32;

                [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                    FLOAT_TYPE sum = FLOAT_TYPE(0.0);
                    [[unroll]] for (uint l = 0; l < 4; ++l) {
                        const uint qs_u32 = shmem_a[qs_u32_base + l];

                        // Each qs_u32 = 4 qs bytes = 4 low nibbles + 4 high nibbles.
                        // Low nibbles → elements [l*4..l*4+3]
                        // High nibbles → elements [l*4+16..l*4+19]
                        const vec4 b_lo = vec4(data_b_v4[(j * p.batch_stride_b + b_offset + y_base) / 4 + l    ]);
                        const vec4 b_hi = vec4(data_b_v4[(j * p.batch_stride_b + b_offset + y_base) / 4 + l + 4]);

                        const uint nl0 =  qs_u32        & 0xf;
                        const uint nl1 = (qs_u32 >>  8) & 0xf;
                        const uint nl2 = (qs_u32 >> 16) & 0xf;
                        const uint nl3 = (qs_u32 >> 24) & 0xf;
                        const uint nh0 = (qs_u32 >>  4) & 0xf;
                        const uint nh1 = (qs_u32 >> 12) & 0xf;
                        const uint nh2 = (qs_u32 >> 20) & 0xf;
                        const uint nh3 = (qs_u32 >> 28) & 0xf;

                        const float vl0 = float(iq4k_values_const[codebook_off + nl0]);
                        const float vl1 = float(iq4k_values_const[codebook_off + nl1]);
                        const float vl2 = float(iq4k_values_const[codebook_off + nl2]);
                        const float vl3 = float(iq4k_values_const[codebook_off + nl3]);
                        const float vh0 = float(iq4k_values_const[codebook_off + nh0]);
                        const float vh1 = float(iq4k_values_const[codebook_off + nh1]);
                        const float vh2 = float(iq4k_values_const[codebook_off + nh2]);
                        const float vh3 = float(iq4k_values_const[codebook_off + nh3]);

                        sum = fma(FLOAT_TYPE(b_lo.x), FLOAT_TYPE(vl0),
                              fma(FLOAT_TYPE(b_lo.y), FLOAT_TYPE(vl1),
                              fma(FLOAT_TYPE(b_lo.z), FLOAT_TYPE(vl2),
                              fma(FLOAT_TYPE(b_lo.w), FLOAT_TYPE(vl3),
                              fma(FLOAT_TYPE(b_hi.x), FLOAT_TYPE(vh0),
                              fma(FLOAT_TYPE(b_hi.y), FLOAT_TYPE(vh1),
                              fma(FLOAT_TYPE(b_hi.z), FLOAT_TYPE(vh2),
                              fma(FLOAT_TYPE(b_hi.w), FLOAT_TYPE(vh3), sum))))))));
                    }
                    temp[j][n] = fma(FLOAT_TYPE(dl), sum, temp[j][n]);
                }
            }
        }
    }

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
