#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage  : require

#include "mul_mat_vec_base.glsl"

// IQ2_K — see dequant_iq2_k.comp for layout (no row_meta, 76 B/block).
// Block size 4-aligned (76/4=19 u32).  Raw u32 view + shmem caching, 8
// threads per super-block (one per 32-element sub-block).

#define BLOCKS_PER_WG 8
#define U32_PER_BLOCK 19

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

// Per-block u32 layout:
//   u32[0]:    d (low 16) | extra (high 16)
//   u32[1..2]: scales[0..7]   (8 bytes)
//   u32[3..18]: qs[0..63]     (64 bytes, 16 u32)
layout(binding = 0) readonly buffer A_RAW {uint32_t data_a_u32[];};

const int iq2nl_values_const[8] = int[8](
    -31, -13,  1, 17,
    -26,  -8,  6, 22
);

shared uint shmem_a[BLOCKS_PER_WG * U32_PER_BLOCK];

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    uint a_offset, b_offset, d_offset;
    get_offsets(a_offset, b_offset, d_offset);

    const uint num_blocks_per_row = p.ncols / QUANT_K;

    const uint tid  = gl_LocalInvocationID.x;
    const uint sb   = tid & 7;          // 0..7 — sub-block ib32
    const uint ix   = tid >> 3;         // 0..7 — block-in-WG
    const uint shift = (sb & 3) << 1;   // 0,2,4,6
    const uint qs_byte_base = (sb >> 2) * 32;

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint k = 0; k < NUM_ROWS; ++k) {
            temp[j][k] = FLOAT_TYPE(0);
        }
    }

    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        const uint row = first_row + n;

        for (uint i_base = 0; i_base < num_blocks_per_row; i_base += BLOCKS_PER_WG) {
            const uint blocks_this_iter = min(uint(BLOCKS_PER_WG),
                                              num_blocks_per_row - i_base);
            const uint u32_to_load = blocks_this_iter * U32_PER_BLOCK;

            barrier();
            // 8 blocks × 19 u32 = 152.  64 threads × 3 u32 each (bounds-checked).
            [[unroll]] for (uint pi = 0; pi < 3; ++pi) {
                const uint shmem_idx = tid + pi * 64;
                if (shmem_idx < u32_to_load) {
                    const uint local_block = shmem_idx / U32_PER_BLOCK;
                    const uint u32_in_block = shmem_idx - local_block * U32_PER_BLOCK;
                    // MUL_MAT_ID: a_offset (QUANT_K-block units) selects the expert weight matrix;
                    // dense / non-id path has a_offset == 0 (no-op). Matches mainline q2_k.
                    const uint global_block = a_offset + (row * num_blocks_per_row) + i_base + local_block;
                    shmem_a[shmem_idx] = data_a_u32[global_block * U32_PER_BLOCK + u32_in_block];
                }
            }
            barrier();

            const uint local_block_idx = ix;
            const uint global_block = i_base + local_block_idx;
            if (local_block_idx < blocks_this_iter) {
                const uint shmem_base = local_block_idx * U32_PER_BLOCK;

                const uint d_extra = shmem_a[shmem_base + 0];
                const float d = float(unpackHalf2x16(d_extra).x);
                const uint  extra = (d_extra >> 16) & 0xffff;

                // scales[sb] is 1 byte at byte offset (4 + sb).
                // u32[1] = scales[0..3], u32[2] = scales[4..7]
                const uint sc_word = shmem_a[shmem_base + 1 + (sb >> 2)];
                const uint sc_byte = (sc_word >> ((sb & 3) * 8)) & 0xff;

                const int sc_lo = int(sc_byte & 0xf) - 8;
                const int sc_hi = int(sc_byte >> 4) - 8;
                const float dl_lo = d * float(sc_lo);
                const float dl_hi = d * float(sc_hi);

                const uint codebook_lo = ((extra >> (2 * sb + 0)) & 1) << 2;
                const uint codebook_hi = ((extra >> (2 * sb + 1)) & 1) << 2;

                // qs base for this sub-block: 32 bytes (8 u32 if sb in [0,3] or [4,7]).
                // u32 offset = 3 + (sb/4)*8 + ... wait, u32 indices [3..18] cover qs[0..63].
                // For sb 0..3: qs[0..31] = u32[3..10]
                // For sb 4..7: qs[32..63] = u32[11..18]
                const uint qs_u32_base = shmem_base + 3 + (sb >> 2) * 8;

                const uint y_base = global_block * 256 + sb * 32;

                [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                    // Low half: y[ib32*32 + 0..15]
                    FLOAT_TYPE sum_lo = FLOAT_TYPE(0.0);
                    [[unroll]] for (uint l = 0; l < 4; ++l) {
                        const uint qs_u32 = shmem_a[qs_u32_base + l];
                        const uint qs0 =  qs_u32        & 0xff;
                        const uint qs1 = (qs_u32 >>  8) & 0xff;
                        const uint qs2 = (qs_u32 >> 16) & 0xff;
                        const uint qs3 = (qs_u32 >> 24) & 0xff;

                        const float v0 = float(iq2nl_values_const[codebook_lo + ((qs0 >> shift) & 3)]);
                        const float v1 = float(iq2nl_values_const[codebook_lo + ((qs1 >> shift) & 3)]);
                        const float v2 = float(iq2nl_values_const[codebook_lo + ((qs2 >> shift) & 3)]);
                        const float v3 = float(iq2nl_values_const[codebook_lo + ((qs3 >> shift) & 3)]);

                        const vec4 b = vec4(data_b_v4[(j * p.batch_stride_b + b_offset + y_base) / 4 + l]);

                        sum_lo = fma(FLOAT_TYPE(b.x), FLOAT_TYPE(v0),
                                 fma(FLOAT_TYPE(b.y), FLOAT_TYPE(v1),
                                 fma(FLOAT_TYPE(b.z), FLOAT_TYPE(v2),
                                 fma(FLOAT_TYPE(b.w), FLOAT_TYPE(v3), sum_lo))));
                    }
                    temp[j][n] = fma(FLOAT_TYPE(dl_lo), sum_lo, temp[j][n]);

                    // High half: y[ib32*32 + 16..31].  Same qs (different bytes 16..31 of stripe).
                    FLOAT_TYPE sum_hi = FLOAT_TYPE(0.0);
                    [[unroll]] for (uint l = 0; l < 4; ++l) {
                        const uint qs_u32 = shmem_a[qs_u32_base + 4 + l];
                        const uint qs0 =  qs_u32        & 0xff;
                        const uint qs1 = (qs_u32 >>  8) & 0xff;
                        const uint qs2 = (qs_u32 >> 16) & 0xff;
                        const uint qs3 = (qs_u32 >> 24) & 0xff;

                        const float v0 = float(iq2nl_values_const[codebook_hi + ((qs0 >> shift) & 3)]);
                        const float v1 = float(iq2nl_values_const[codebook_hi + ((qs1 >> shift) & 3)]);
                        const float v2 = float(iq2nl_values_const[codebook_hi + ((qs2 >> shift) & 3)]);
                        const float v3 = float(iq2nl_values_const[codebook_hi + ((qs3 >> shift) & 3)]);

                        const vec4 b = vec4(data_b_v4[(j * p.batch_stride_b + b_offset + y_base + 16) / 4 + l]);

                        sum_hi = fma(FLOAT_TYPE(b.x), FLOAT_TYPE(v0),
                                 fma(FLOAT_TYPE(b.y), FLOAT_TYPE(v1),
                                 fma(FLOAT_TYPE(b.z), FLOAT_TYPE(v2),
                                 fma(FLOAT_TYPE(b.w), FLOAT_TYPE(v3), sum_hi))));
                    }
                    temp[j][n] = fma(FLOAT_TYPE(dl_hi), sum_hi, temp[j][n]);
                }
            }
        }
    }

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
