        oscar_min[ib] = mn;
        oscar_max[ib] = mx;
    }
    barrier();

    const float bmin  = oscar_min[ib];
    const float range = oscar_max[ib] - bmin;
    const float bd    = (range > 1e-10) ? (range / 3.0) : 1.0;
    oscar_lvl[t] = uint(clamp(int(round((oscar_x[t] - bmin) / bd)), 0, 3));
