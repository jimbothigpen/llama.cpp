shared float sg_acc[16];
shared float sg_min_cost[16];
shared int   sg_min_idx[16];
shared uint  outputs_arr[128];      // backtrack symbols, 0..7 per slot
shared float gnrm_tcq3;
shared float saved_norm_tcq3;
shared int   final_state_tcq3;
shared float final_norm_tcq3;

