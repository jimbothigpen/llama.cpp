    const uint ig  = tmp % gpr; tmp /= gpr;
    const uint i01 = tmp % p.ne01; tmp /= p.ne01;
    const uint i02 = tmp % p.ne02;
    const uint i03 = tmp / p.ne02;

    const uint sb  = src0_idx(ig * 128, i01, i02, i03) + get_aoffset();
    const uint i1  = data_i[src1_idx(i01, fastmod(i02, p.ne11), fastmod(i03, p.ne12), 0) + get_boffset()] DATA_I_SWIZZLE;
    const uint db  = dst_idx(ig, i1, i02, i03) + get_doffset();

    wht_t3[t] = data_s[sb + t];
    barrier();

    float v2 = wht_t3[t] * wht_t3[t];
    v2 = subgroupAdd(v2);
    if (gl_SubgroupInvocationID == 0) sg_acc_t3[gl_SubgroupID] = v2;
    barrier();
    if (t == 0) {
        float total = 0.0;
        for (uint w = 0; w < gl_NumSubgroups; w++) total += sg_acc_t3[w];
        gnrm_t3 = sqrt(total);
    }
    barrier();

    wht_t3[t] *= (gnrm_t3 > 1e-10) ? (1.0 / gnrm_t3) : 0.0;
    barrier();

    wht_t3[t] *= TS1_T3[t];
