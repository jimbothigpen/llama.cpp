    cost_b[t] = 0.0;
    [[unroll]] for (uint i = 0u; i < 4u; i++) {
        bt_packed[t * 4u + i] = 0u;
    }
    barrier();

    // Step 6: Viterbi forward pass (128 steps, double-buffered cost)
    //   trellis transition: state_t = (state_{t-1} >> 3) | (output_t << 6)
    //   so the 8 predecessors of state s share the low 6 bits (s.low6 = prev>>3 & 0x3F),
    //   meaning only 64 unique min-over-8 reductions are needed per step.
