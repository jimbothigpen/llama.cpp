    // Step 7: argmin over 512 final costs (cost_a)
    {
        float my_cost = cost_a[t];
        int   my_idx  = int(t);
        for (uint offset = gl_SubgroupSize >> 1u; offset > 0u; offset >>= 1u) {
            float other_cost = subgroupShuffleXor(my_cost, offset);
            int   other_idx  = subgroupShuffleXor(my_idx,  offset);
            if (other_cost < my_cost) { my_cost = other_cost; my_idx = other_idx; }
        }
        if (gl_SubgroupInvocationID == 0u) {
            sg_min_cost[gl_SubgroupID] = my_cost;
            sg_min_idx[gl_SubgroupID]  = my_idx;
        }
    }
    barrier();
    if (t == 0u) {
        float bc = sg_min_cost[0];
        int   bi = sg_min_idx[0];
        for (uint w = 1u; w < gl_NumSubgroups; w++) {
            if (sg_min_cost[w] < bc) { bc = sg_min_cost[w]; bi = sg_min_idx[w]; }
        }
        final_state_tcq3 = bi;
    }
    barrier();

    // Step 8: sequential backtrack (thread 0 only). After the walk, `state`
    // holds the start state (state at "time -1") — what we encode as init_bits.
