        }
        final_state_tcq3 = state;  // start state
    }
    barrier();

    // Step 9: parallel reconstruction norm. cur_state at time t in 0..127:
    //   t=0:  (start>>3) | (out0<<6)
    //   t=1:  (start>>6) | (out0<<3) | (out1<<6)
    //   t>=2: out_{t-2} | (out_{t-1}<<3) | (out_t<<6)
    // The trellis shifts out start_state's low 3 bits at t=0 and shifts out
    // start_state entirely by t=2, so for t>=2 cur_state depends only on outputs.
    float my_recon_sq = 0.0;
    if (t < 128u) {
        int cur_state;
        if (t < 2u) {
            cur_state = final_state_tcq3;
            for (uint k = 0u; k <= t; k++) {
                cur_state = (cur_state >> 3) | (int(outputs_arr[k] & 0x7u) << 6);
            }
        } else {
            cur_state =  int(outputs_arr[t - 2u] & 0x7u)
                      | (int(outputs_arr[t - 1u] & 0x7u) << 3)
                      | (int(outputs_arr[t]      & 0x7u) << 6);
        }
        const float c = TCQ3_CB[cur_state];
        my_recon_sq = c * c;
    }
    {
        float r = subgroupAdd(my_recon_sq);
        if (gl_SubgroupInvocationID == 0u) sg_acc[gl_SubgroupID] = r;
    }
    barrier();
    if (t == 0u) {
        float total = 0.0;
        for (uint w = 0u; w < gl_NumSubgroups; w++) total += sg_acc[w];
        const float recon_norm     = sqrt(total);
        const float corrected      = (recon_norm > 1e-10) ? (saved_norm_tcq3 / recon_norm) : saved_norm_tcq3;
        final_norm_tcq3 = corrected * TCQ3_NORM_ALPHA;
    }
    barrier();

    // Step 10: bitpack qs[49] in parallel. Layout: 6 init bits at qs[0] LSB,
    // followed by 128 × 3-bit symbols starting at bit 6 of qs[0].
    if (t < 49u) {
        const uint init_bits = (uint(final_state_tcq3) >> 3u) & 0x3Fu;
        uint packed = 0u;
        [[unroll]] for (uint bit = 0u; bit < 8u; bit++) {
            const uint pos = t * 8u + bit;
            uint v = 0u;
            if (pos < 6u) {
                v = (init_bits >> pos) & 1u;
            } else {
                const uint sym_bit_pos = pos - 6u;
                const uint sym_idx     = sym_bit_pos / 3u;
                if (sym_idx < 128u) {
                    v = (outputs_arr[sym_idx] >> (sym_bit_pos % 3u)) & 1u;
                }
            }
            packed |= (v << bit);
        }
        data_q[db].qs[t] = uint8_t(packed);
    }

    // Step 11: norm
    if (t == 0u) {
        data_q[db].norm = float16_t(final_norm_tcq3);
    }
}
