#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage  : require

#include "mul_mat_vec_base.glsl"

// IQ5_KS — see dequant_iq5_ks.comp for layout.  data_a[] bound as uint32_t[];
// 168B/block = 42 u32, row stride 4 + nb*168 is 4-aligned.
//
// Threading mirrors mul_mat_vec_iq4_ks.comp:
//   - 64 threads/WG, 8 threads per super-block (1 thread per sub-block ib=0..7)
//   - BLOCKS_PER_WG super-blocks of A cooperatively staged into shared memory
//   - NUM_ROWS rows per WG; shmem reloaded per row.

#define BLOCKS_PER_WG 8
#define U32_PER_BLOCK 42

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

const int iq5nl_values[64] = int[64](
    -126,-114,-103, -92, -83, -74, -65, -57, -50, -43, -36, -30, -24, -18, -12, -6,
      -1,   5,  11,  17,  23,  29,  36,  43,  51,  59,  68,  77,  87,  97, 109, 121,
    -124,-112,-101, -90, -81, -72, -63, -55, -48, -41, -34, -28, -22, -16, -10,  -4,
       1,   7,  13,  19,  25,  31,  38,  45,  53,  61,  70,  79,  89,  99, 111, 123
);

// 8 blocks × 42 u32 = 336 uints = 1344 bytes shared memory.
shared uint shmem_a[BLOCKS_PER_WG * U32_PER_BLOCK];

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    uint a_offset, b_offset, d_offset;
    get_offsets(a_offset, b_offset, d_offset);

    const uint num_blocks_per_row = p.ncols / QUANT_K;
    const uint row_size_u32       = 1 + num_blocks_per_row * U32_PER_BLOCK;

    const uint tid = gl_LocalInvocationID.x;
    const uint ib  = tid & 7;     // 0..7 — sub-block this thread handles
    const uint ix  = tid >> 3;    // 0..7 — block-in-WG index (WG=64)
    const uint ib64 = ib >> 1;    // 0..3 group
    const uint nibh = ib & 1;     // 0 low nibble / 1 high nibble

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j)
        [[unroll]] for (uint kk = 0; kk < NUM_ROWS; ++kk)
            temp[j][kk] = FLOAT_TYPE(0);

    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        const uint row     = first_row + n;
        const uint row_u32 = row * row_size_u32;
        const float d_row  = uintBitsToFloat(data_a[row_u32]);

        for (uint i_base = 0; i_base < num_blocks_per_row; i_base += BLOCKS_PER_WG) {
            const uint blocks_this_iter = min(uint(BLOCKS_PER_WG), num_blocks_per_row - i_base);
            const uint u32_to_load = blocks_this_iter * U32_PER_BLOCK;     // ≤ 336

            barrier();
            // 336 / 64 = 5.25 → each thread loads up to 6 u32 (bounded).
            [[unroll]] for (uint pi = 0; pi < 6; ++pi) {
                const uint shmem_idx = tid + pi * 64;
                if (shmem_idx < u32_to_load) {
                    const uint local_block = shmem_idx / U32_PER_BLOCK;
                    const uint u32_in_block = shmem_idx - local_block * U32_PER_BLOCK;
                    const uint global_block = i_base + local_block;
                    const uint global_u32   = row_u32 + 1 + global_block * U32_PER_BLOCK + u32_in_block;
                    shmem_a[shmem_idx] = data_a[global_u32];
                }
            }
            barrier();

            const uint global_block = i_base + ix;
            if (global_block < num_blocks_per_row) {
                const uint shmem_base = ix * U32_PER_BLOCK;

                // Scale byte for this sub-block: scales[ib] lives in u32 (ib>>2) of the block.
                const uint sc_word = shmem_a[shmem_base + (ib >> 2)];
                const uint sc_byte = (sc_word >> ((ib & 3) * 8)) & 0xff;
                const int  ls = int(sc_byte & 254) - 127;
                const float dl = d_row * float(ls);
                const uint cb_off = (sc_byte & 1) << 5;

                // qs base: byte 8 = u32 (shmem_base+2); this sub-block's 32 qs bytes at +32*ib64.
                // qh base: byte 136 = u32 (shmem_base+34); 32 bytes, bit selected per ib64/nibh.
                const uint qs_u32_blk = shmem_base + 2;
                const uint qh_u32_blk = shmem_base + 34;
                const uint qh_shift   = 2*ib64 + nibh;

                // This sub-block's 32 output elements occupy global slice:
                //   y[ global_block*256 + 64*ib64 + nibh*32 .. +31 ]
                const uint y_base = global_block * 256 + 64*ib64 + nibh*32;

                [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                    FLOAT_TYPE sum = FLOAT_TYPE(0.0);
                    // 32 elements, 8 at a time via vec4 pairs of B.
                    [[unroll]] for (uint e8 = 0; e8 < 4; ++e8) {
                        const vec4 b0 = vec4(data_b_v4[(j * p.batch_stride_b + b_offset + y_base) / 4 + e8*2 + 0]);
                        const vec4 b1 = vec4(data_b_v4[(j * p.batch_stride_b + b_offset + y_base) / 4 + e8*2 + 1]);
                        [[unroll]] for (uint t = 0; t < 8; ++t) {
                            const uint elem = e8*8 + t;                 // 0..31 within sub-block
                            const uint qs_byte_idx = 32*ib64 + elem;     // 0..127
                            const uint qs_w = shmem_a[qs_u32_blk + (qs_byte_idx >> 2)];
                            const uint qs_b = (qs_w >> ((qs_byte_idx & 3) * 8)) & 0xff;
                            const uint nib  = (nibh == 0u) ? (qs_b & 0xf) : (qs_b >> 4);
                            const uint qh_w = shmem_a[qh_u32_blk + (elem >> 2)];
                            const uint qh_b = (qh_w >> ((elem & 3) * 8)) & 0xff;
                            const uint idx5 = nib | (((qh_b >> qh_shift) & 1u) << 4);
                            const float val = float(iq5nl_values[cb_off + idx5]);
                            const float bval = (t < 4) ? b0[t] : b1[t - 4];
                            sum = fma(FLOAT_TYPE(bval), FLOAT_TYPE(val), sum);
                        }
                    }
                    temp[j][n] = fma(FLOAT_TYPE(dl), sum, temp[j][n]);
                }
            }
        }
    }
    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);
    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) return;
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
