#version 450

/*
 * Pass 3 — z-normalize the per-KV-head aggregate across tokens, weight positive
 * z by layer importance, max-aggregate into global_scores (Vulkan port of
 * tria_znorm_lw_global_kernel). Single workgroup.
 * Level-2 std = sqrt(var/n + 1e-8) (matches the runtime level-2 aggregation).
 */

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Agg    { float agg[];          };
layout(std430, binding = 1)          buffer Global { float global_scores[]; };

layout(push_constant) uniform Push {
    int   n_tokens;
    float layer_weight;
} pc;

shared float smem[256];

float block_sum(float v) {
    const uint t = gl_LocalInvocationID.x;
    smem[t] = v;
    barrier();
    for (uint st = 128u; st > 0u; st >>= 1u) {
        if (t < st) smem[t] += smem[t + st];
        barrier();
    }
    return smem[0];
}

void main() {
    const uint t = gl_LocalInvocationID.x;
    const int  n = pc.n_tokens;

    float ls = 0.0;
    for (int i = int(t); i < n; i += 256) ls += agg[i];
    const float mean = block_sum(ls) / float(n);
    barrier();

    float lv = 0.0;
    for (int i = int(t); i < n; i += 256) {
        const float d = agg[i] - mean;
        lv += d * d;
    }
    const float std = sqrt(block_sum(lv) / float(n) + 1e-8);
    barrier();

    for (int i = int(t); i < n; i += 256) {
        const float z  = (agg[i] - mean) / std;
        const float wz = z > 0.0 ? z * pc.layer_weight : z;
        if (wz > global_scores[i]) global_scores[i] = wz;
    }
}
