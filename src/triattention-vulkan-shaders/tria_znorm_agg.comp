#version 450

/*
 * Pass 2 — z-normalize raw scores across tokens, max-aggregate across the KV
 * head's query heads (Vulkan port of tria_znorm_into_agg_kernel). Single
 * workgroup. is_first selects assign vs max (mirrors CPU `first`).
 * Level-1 std = sqrt(var/n), floored to 1e-6 (matches tria_score_kv_head).
 */

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Scores { float scores[]; };
layout(std430, binding = 1)          buffer Agg    { float agg[];    };

layout(push_constant) uniform Push {
    int n_tokens;
    int is_first;
} pc;

shared float smem[256];

float block_sum(float v) {
    const uint t = gl_LocalInvocationID.x;
    smem[t] = v;
    barrier();
    for (uint st = 128u; st > 0u; st >>= 1u) {
        if (t < st) smem[t] += smem[t + st];
        barrier();
    }
    return smem[0];
}

void main() {
    const uint t = gl_LocalInvocationID.x;
    const int  n = pc.n_tokens;

    float ls = 0.0;
    for (int i = int(t); i < n; i += 256) ls += scores[i];
    const float mean = block_sum(ls) / float(n);
    barrier();

    float lv = 0.0;
    for (int i = int(t); i < n; i += 256) {
        const float d = scores[i] - mean;
        lv += d * d;
    }
    float std = sqrt(block_sum(lv) / float(n));
    if (std < 1e-6) std = 1e-6;
    barrier();

    for (int i = int(t); i < n; i += 256) {
        const float z = (scores[i] - mean) / std;
        if (pc.is_first != 0)      agg[i] = z;
        else if (z > agg[i])       agg[i] = z;
    }
}
